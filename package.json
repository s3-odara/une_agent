{
	"name": "agent",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"start": "node --env-file-if-exists=.env src/main.ts",
		"build:gateway": "cargo build --release --manifest-path gateway/Cargo.toml",
		"login": "cargo run --release --manifest-path gateway/Cargo.toml -- login",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"test/**/*.test.ts\"",
		"browser-login": "node --env-file-if-exists=.env src/browser-login.ts",
		"browser-install": "playwright-core install chromium"
	},
	"dependencies": {
		"@earendil-works/chord": "1.5.2",
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-durable": "1.5.2",
		"@earendil-works/pi-schema": "1.5.2",
		"ical.js": "2.2.1",
		"playwright-core": "1.64.1",
		"tsdav": "2.5.0"
	},
	"devDependencies": {
		"@types/node": "26.6.6",
		"typescript": "7.0.2"
	}
}
