{
	"events": [
		{
			"type": "ready",
			"userId": "@agent:example.org",
			"deviceId": "DEVICE"
		},
		{
			"type": "ready",
			"userId": "@agent:example.org",
			"deviceId": "DEVICE",
			"uploadLimit": 52428800
		},
		{
			"type": "message",
			"roomId": "!r:example.org",
			"eventId": "$text",
			"body": "hi",
			"ts": 5
		},
		{
			"type": "message",
			"roomId": "!r:example.org",
			"eventId": "$voice",
			"body": "Voice message.ogg",
			"ts": 6,
			"attachment": {
				"path": "/d/v.ogg",
				"mimeType": "audio/ogg",
				"voice": true
			}
		},
		{
			"type": "message",
			"roomId": "!r:example.org",
			"eventId": "$file",
			"body": "song.mp3",
			"ts": 7,
			"attachment": {
				"path": "/d/f.audio",
				"mimeType": "audio/mpeg"
			}
		},
		{
			"type": "message",
			"roomId": "!r:example.org",
			"eventId": "$reply",
			"body": "AB12CD",
			"ts": 8,
			"replyTo": "$p"
		},
		{
			"type": "undecryptable",
			"roomId": "!r:example.org",
			"eventId": "$e"
		},
		{
			"type": "mediaFailed",
			"roomId": "!r:example.org",
			"eventId": "$m",
			"reason": "too large"
		},
		{
			"type": "sent",
			"requestId": "q",
			"eventId": "$s"
		},
		{
			"type": "error",
			"requestId": "q",
			"message": "boom"
		},
		{
			"type": "error",
			"message": "boom"
		},
		{
			"type": "reaction",
			"roomId": "!r:example.org",
			"eventId": "$x",
			"relatesTo": "$p",
			"key": "✅"
		},
		{
			"type": "callLeft",
			"roomId": "!r:example.org",
			"reason": "no LiveKit focus"
		},
		{
			"type": "callSpeech",
			"roomId": "!r:example.org"
		},
		{
			"type": "callUtterance",
			"roomId": "!r:example.org",
			"path": "/d/u.wav",
			"startedAt": 5
		},
		{
			"type": "callSpoken",
			"roomId": "!r:example.org",
			"id": "s1"
		}
	],
	"commands": [
		{
			"type": "ack",
			"eventId": "$e"
		},
		{
			"type": "send",
			"requestId": "q",
			"roomId": "!r:example.org",
			"txnId": "t",
			"body": "hello",
			"notice": true
		},
		{
			"type": "send",
			"requestId": "q",
			"roomId": "!r:example.org",
			"txnId": "t",
			"body": "hello again",
			"notice": true,
			"replaces": "$p"
		},
		{
			"type": "sendAttachment",
			"requestId": "q",
			"roomId": "!r:example.org",
			"txnId": "t",
			"path": "/d/v.ogg",
			"name": "voice-message.ogg",
			"mimeType": "audio/ogg",
			"voice": {
				"durationMs": 1500,
				"waveform": [
					0.5,
					0.25
				]
			}
		},
		{
			"type": "sendAttachment",
			"requestId": "q",
			"roomId": "!r:example.org",
			"txnId": "t",
			"path": "/d/s.png",
			"name": "screenshot.png",
			"mimeType": "image/png",
			"width": 1280,
			"height": 800
		},
		{
			"type": "sendAttachment",
			"requestId": "q",
			"roomId": "!r:example.org",
			"txnId": "t",
			"path": "/d/f.bin",
			"name": "report.xlsx",
			"mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
		},
		{
			"type": "typing",
			"roomId": "!r:example.org",
			"on": true
		},
		{
			"type": "react",
			"requestId": "q",
			"roomId": "!r:example.org",
			"txnId": "t",
			"eventId": "$p",
			"key": "❌"
		},
		{
			"type": "callSpeak",
			"roomId": "!r:example.org",
			"id": "s1",
			"path": "/d/s1.wav"
		}
	]
}
